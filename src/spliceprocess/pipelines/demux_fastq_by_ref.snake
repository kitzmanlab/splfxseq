######################################################
# Configuration values you must specify:
#
#
# > lib_table: library counts report, output from count_isoform_events_singleref.smk  
#  one row per sequencing library to be processed
#   required columns
#   - libname   (this nust be uniq; if you are running the same lib across multiple batches you need to 
#   - fastq_fwd  (path to forward read fastq file)
#   - fastq_rev  (path to reverse read fastq file)
#   
#
#  
#  
# > pairing_db:  a path to the pairing duckdb file for the library of interest, the db must have a table named haps with readgroupid and refname columns
#
# > outdir
# 
#######################################################
#  optional config values:
# pairing_tbl_name : pairing_tbl_name in duckdb, default is haps
# select_wt_only : if True, only output reads whose refname has n_variants_passing == 0 i.e WT. Default is False.


#######################################################

import os.path as op
import os
import pandas as pd
import pysam 
import Bio.Seq
import duckdb
import shutil



########

localrules: all, collate_by_refname, out_rpt_perlib

assert 'lib_table' in config, 'must specify sample table'
assert 'pairing_db' in config, 'must specify pairing database'


OUT_DIR = config['outdir']

########
#
# load and check sample table.

l_reqd_cols = [ 'libname', 'fastq_fwd', 'fastq_rev']
tbl_lib = pd.read_table( config['lib_table'] )
assert all( [ col in tbl_lib.columns for col in l_reqd_cols ] ), 'lib table must have columns: '+','.join(l_reqd_cols)
assert len(set(tbl_lib['libname'])) == tbl_lib.shape[0], 'all libname entries must be unique'
  
tbl_lib = tbl_lib.set_index( 'libname',drop=False )

lLibs = tbl_lib['libname'].unique()

########
#
# load and check pairing db
SELECT_WT_ONLY = config.get('select_wt_only', False)

PAIRING_DB = config['pairing_db']
pairing_tbl_name = config['pairing_tbl_name'] if 'pairing_tbl_name' in config else 'haps'
lreqd_cols_pairing_db = [ 'readgroupid', 'refname' ]
if SELECT_WT_ONLY:
    lreqd_cols_pairing_db.append('n_variants_passing')
con = duckdb.connect(PAIRING_DB, read_only=True)

# check the table exists
existing_tables = {
    row[0]
    for row in con.execute(
        "SELECT table_name FROM information_schema.tables WHERE table_schema = 'main'"
    ).fetchall()
}
assert pairing_tbl_name in existing_tables, (
    f"Table '{pairing_tbl_name}' not found. Available tables: {sorted(existing_tables)}"
)


existing_columns = {
    row[0]
    for row in con.execute(
        "SELECT column_name FROM information_schema.columns WHERE table_name = ?",
        [pairing_tbl_name],
    ).fetchall()
}

missing = set(lreqd_cols_pairing_db) - set(existing_columns)
assert not missing, (
    f"Table '{pairing_tbl_name}' is missing columns: {sorted(missing)}. "
    f"Available columns: {sorted(existing_columns)}"
)
con.close()

########
# expected output files

assert 'outdir' in config, 'must specify output directory'

#######

# outputs


l_out_demux_rpt = expand('{}/perlib/{{libname}}/demux_report.txt'.format(OUT_DIR), libname=lLibs)

out_perref_file = OUT_DIR + '/demux_report_perref.txt'
outRpt = OUT_DIR+'/'+'demux_report_perlib.txt'
lOutFiles = [outRpt, out_perref_file] + l_out_demux_rpt

########

rule all:
    input:
        lOutFiles

rule demux_paired_fastq:
    input:
        fq_fwd = lambda wc: tbl_lib.loc[ wc.libname ][ 'fastq_fwd' ],
        fq_rev = lambda wc: tbl_lib.loc[ wc.libname ][ 'fastq_rev' ],

    params:
        pairing_db = PAIRING_DB,
        fastq_outdir = lambda wc: op.join(OUT_DIR, 'perlib/', wc.libname + '/fastq'),
        pairing_tbl_name = pairing_tbl_name,
        wt_flag = '--select_wt_only' if SELECT_WT_ONLY else ''
    output:
        out_demux_rpt = op.join(OUT_DIR, 'perlib/'+'{libname}/demux_report.txt')
       
    threads: 8
    resources:
        mem_per_cpu="10gb", 
        cpus="8", 
        runtime="2h"
    run:
            shell("""
                demux_fastq_by_ref \
                --fq_fwd {input.fq_fwd} \
                --fq_rev {input.fq_rev} \
                --pairing_db {params.pairing_db} \
                --pairing_tbl_name {params.pairing_tbl_name} \
                --fq_outdir {params.fastq_outdir} \
                --libname {wildcards.libname} \
                --out_rpt {output.out_demux_rpt} \
                --threads {threads} \
                {params.wt_flag}
            """)


rule collate_by_refname:
    input:
        lib_dmx_rpts = expand(rules.demux_paired_fastq.output.out_demux_rpt, libname=lLibs),
    
    output:
        perref_rpt = OUT_DIR + '/demux_report_perref.txt'

    params:
        perref_dir = OUT_DIR + '/perref'

    run:
        if os.path.exists(params.perref_dir):
            shutil.rmtree(params.perref_dir)
        
        os.makedirs(params.perref_dir, exist_ok=True)

        # concatenate every per-library demux report
        dfs = [pd.read_table(r) for r in input.lib_dmx_rpts]
        dfs = [d for d in dfs if d.shape[0] > 0]

        written = []

        if not dfs:
            # nothing demuxed at all; leave empty dir
            print("No demux reports contained any refnames.")
            
        else:
            allrpt = pd.concat(dfs, ignore_index=True)
            # one file per refname that actually appeared
            for refname, sub in allrpt.groupby('refname'):
                out_path = os.path.join(params.perref_dir, f'{refname}.txt')
                sub.to_csv(out_path, sep='\t', index=False)
                written.append((refname, out_path))

        pd.DataFrame(written, columns=['refname', 'path']).to_csv(
            output.perref_rpt, sep='\t', index=False)


rule out_rpt_perlib:
    input:
        lib_dmx_rpts = expand(rules.demux_paired_fastq.output.out_demux_rpt, libname=lLibs),
    output:
        demux_perlib_rpt = op.join(OUT_DIR,'demux_report_perlib.txt')
    run:
        out_rpt = {k:[] for k in 'libname,demux_report'.split(',')}
        out_rpt['libname'] = lLibs
        out_rpt['demux_report'] = list(input.lib_dmx_rpts)
        out_rpt = pd.DataFrame(out_rpt)
        out_rpt.to_csv(output.demux_perlib_rpt, sep='\t', index=False)
